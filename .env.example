# Never commit real credentials.
HF_TOKEN=
WANDB_API_KEY=
OPENAI_API_KEY=

# Training defaults. Override per machine.
CUDA_VISIBLE_DEVICES=
DRIFTSQL_ARTIFACT_DIR=artifacts
DRIFTSQL_BASE_PYTHON=python3.11
DRIFTSQL_MODEL_PATH=/path/to/driftsql-rl/models/Qwen2.5-Coder-7B-Instruct

# Product API and CLI. The default backend is persistent vLLM.
DRIFTSQL_SERVICE_HOST=127.0.0.1
DRIFTSQL_SERVICE_PORT=8001
DRIFTSQL_SERVICE_MODEL_BACKEND=vllm
DRIFTSQL_SERVICE_DEFAULT_MODEL_ID=grpo-step25-seed20260810
DRIFTSQL_SERVICE_ADAPTER_PATH=/path/to/driftsql-rl/checkpoints/p6_contract_observation_grpo_arm_c_7b/global_step_25/merged/lora_adapter
DRIFTSQL_SERVICE_TENSOR_PARALLEL_SIZE=2
DRIFTSQL_SERVICE_MAX_CONCURRENT_SESSIONS=2
DRIFTSQL_SERVICE_GPU_MEMORY_UTILIZATION=0.82
DRIFTSQL_SERVICE_EXECUTOR_MAX_ROWS=5
DRIFTSQL_SERVICE_SCHEMA_MAX_CHARS=3500
DRIFTSQL_SERVICE_KNOWLEDGE_MAX_RESULTS=1
DRIFTSQL_SERVICE_TRANSLATION_ENABLED=true
DRIFTSQL_SERVICE_TRANSLATION_MODEL_PATH=/path/to/driftsql-rl/models/Qwen2.5-0.5B-Instruct
DRIFTSQL_SERVICE_TRANSLATION_MAX_INPUT_TOKENS=512
DRIFTSQL_SERVICE_TRANSLATION_MAX_NEW_TOKENS=256
DRIFTSQL_SERVICE_MODEL_REGISTRY_PATH=/path/to/driftsql-rl/configs/service/models.yaml
DRIFTSQL_SERVICE_EXPERIMENT_CATALOG_PATH=/path/to/driftsql-rl/configs/service/experiments.json
DRIFTSQL_SERVICE_REPLAY_REVIEW_DIR=/path/to/driftsql-rl/data/processed/p4_replay_review
DRIFTSQL_SERVICE_AUTH_ENABLED=false
DRIFTSQL_SERVICE_API_KEY=
DRIFTSQL_SERVICE_AUTH_SESSION_TTL_SECONDS=28800
DRIFTSQL_SERVICE_AUTH_COOKIE_SECURE=false

# P4 observability. W&B remains optional and credentials stay server-side.
DRIFTSQL_SERVICE_WANDB_ENABLED=false
DRIFTSQL_SERVICE_WANDB_ENTITY=
DRIFTSQL_SERVICE_WANDB_PROJECT=driftsql-rl
DRIFTSQL_SERVICE_WANDB_MAX_RUNS=20
